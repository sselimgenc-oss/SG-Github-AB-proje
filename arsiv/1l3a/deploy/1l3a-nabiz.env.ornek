# /etc/1l3a-nabiz.env (chmod 600, root) — dış nabız alarmı. Asla repoya girmez; burada DEĞER YOK.
# Ayrı dosya: nabız servisi (kullanıcı l3a) yalnız bunu okur, Cloudflare token'ını görmez.
# Paylaşılan anahtar (ZORUNLU, en az 32 karakter): openssl rand -hex 32
NABIZ_ANAHTAR=
# Worker adı (varsayılan 1l3a-nabiz) ve adresi; adres ilk yayında betik çıktısında görünür: https://<NABIZ_AD>.<hesap-alt-alanı>.workers.dev
NABIZ_AD=1l3a-nabiz
NABIZ_URL=
