# /etc/1l3a-pano.env olarak kopyalayın (chmod 600). Anahtarı ve şifreyi ASLA repoya/sohbete koymayın.
# Cloudflare: My Profile -> API Tokens -> Create Token -> "Edit Cloudflare Workers" şablonu.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PANO_AD=1l3a-pano
# PANO_SIFRE KALDIRILDI (Basic Auth yok; pano artık Cloudflare Access JWT ile korunur). Eski satır varsa silin; yok sayılır.
# İsteğe bağlı: Access uygulamasının AUD etiketi (gizli değil; Worker "vars" olarak gider). Tanımsızsa aud denetlenmez.
# Access uygulaması -> Overview -> "Application Audience (AUD) Tag"
ACCESS_AUD=
# İsteğe bağlı: Access takım adı (varsayılan slmgncortak)
#ACCESS_TAKIM=slmgncortak
