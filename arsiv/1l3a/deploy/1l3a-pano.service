# Pano üretimi (tek seferlik; zamanlayıcı 1l3a-pano.timer çağırır). Pano hesap yapmaz: motorun yazdığı durum dosyalarını biçimler.
[Unit]
Description=1L3A pano üretimi

[Service]
Type=oneshot
User=l3a
Group=l3a
WorkingDirectory=/opt/1l3a
StateDirectory=1l3a-paper
# CT konsensüs ve aday hesaplarının durum dizinleri (pano kartları; yalnız OKUR). ct dizini ayrı servisin StateDirectory'si: "-" = yoksa hata verme.
Environment=L3A_CT_DURUM=/var/lib/1l3a-ct-paper/durum/ct_konsensus
Environment=L3A_ADAY_DURUM=/var/lib/1l3a-paper/durum/adaylar
ReadOnlyPaths=-/var/lib/1l3a-ct-paper
ExecStart=/opt/1l3a/.venv/bin/python -m motor.canli.pano --durum ${STATE_DIRECTORY}/durum --cikti ${STATE_DIRECTORY}/durum/pano.html
# işlem mutabakatı (motor = pano = Telegram): her pano üretiminden sonra mutabakat_v1.json(+.md); "-" öneki: hata pano üretimini/yayınını DÜŞÜRMEZ
ExecStartPost=-/opt/1l3a/.venv/bin/python -m araclar.islem_mutabakat --durum ${STATE_DIRECTORY}/durum
# pano çıkış kodu 2 = kritik uyarı var (HTML yine de yazılır); bu servisin hatası sayılmasın.
# Çıkış kodu 1 = durum dosyaları eksik/bozuk: BAŞARISIZ sayılır (systemctl --failed / status kırmızı gösterir).
SuccessExitStatus=0 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
