# /etc/trader-testnet.env  (izin 0600, sahibi root). SADECE Binance Futures TESTNET anahtari (testnet.binancefuture.com).
# Canli (gercek) anahtar ASLA buraya yazilmaz; canli anahtar ayri dosyada tutulur. Sir degerleri depoya girmez.
# Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger. Esittir cevresinde bosluk yok; tirnak yok.
# Iki anahtar da dolana kadar trader-engine-testnet.service ACILMAZ (install.sh).
BINANCE_API_KEY=
BINANCE_API_SECRET=
