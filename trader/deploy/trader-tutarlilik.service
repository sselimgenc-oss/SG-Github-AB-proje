[Unit]
Description=Trader kagit-geri test tutarlilik raporu (haftalik; yalniz bilgi; docs/motor/tutarlilik-raporu-spec.md)
Documentation=file:///opt/trader/docs/motor/tutarlilik-raporu-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
# Geri test (`backtest --env paper`, ayni strateji/arms/kume/maliyet) son 7 tam UTC gunu icin; kilitli doneme dusen kisim kesilir.
# Cikti: var/rapor/tutarlilik/<tarih>.md ve var/durum/tutarlilik_v1.json (atomik). Cikis 0: TIKANDI da dosyaya yazilir (motor etkilenmez).
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/tutarlilik_run.py --once
# Sure: 44 cift x 7 gun x 672 adet 15 dk karar adimi (kagit motoruyla ayni hesap); olculen ~10-18 sn/adim (tek cekirdek) => ~2-3.5 saat; CPUQuota
# %50 ile ~2 kat; bu yuzden uzun zaman asimi (yalniz bilgi isi; motor etkilenmez, Nice=10)
TimeoutStartSec=36000
# MemoryMax: 44 cift, bilesik strateji, store kaynagi icin olculen tepe RSS ~135 MB; ~2,2 kat pay (docs/motor/tutarlilik-raporu-spec.md notu)
MemoryMax=300M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var/rapor /opt/trader/var/durum -/opt/trader/var/learner -/opt/trader/var/market.sqlite-wal -/opt/trader/var/market.sqlite-shm
ReadOnlyPaths=-/opt/trader/var/learner/ledger.sqlite -/opt/trader/var/market.sqlite
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
