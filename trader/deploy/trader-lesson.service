[Unit]
Description=Trader gunluk ders servisi (tek seferlik tick)
Documentation=file:///opt/trader/docs/ders-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
EnvironmentFile=/etc/trader-lesson.env
EnvironmentFile=-/etc/trader-telegram.env
SupplementaryGroups=trader-tg
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/lesson_run.py --once
TimeoutStartSec=300
# 2: calisma `failed` (beklenen; bildirim ders servisinden gider). 1 (yapilandirma, bildirimci yok), 3 (bozulmus:
# ledger_only/yedek yazilamadi/saat kilidi/defter yok) ve cokus OnFailure tetikler: 3 BILEREK SuccessExitStatus disinda (Revizyon 3)
SuccessExitStatus=2
MemoryMax=256M
CPUQuota=30%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
# user_data DIZIN duzeyinde yazilir: SQLite -journal/-wal/-shm yan dosyalari dizinde olusur (dosya-duzeyi RW bunu yapamaz; OPEN-2).
# var/learner: aktivasyon icin ogrenen defteri yazma; (DD-12: ikiz kaldirildi)
ReadWritePaths=/opt/trader/user_data /opt/trader/var/telegram -/opt/trader/var/learner -/opt/trader/var-live/learner
NoNewPrivileges=true
PrivateTmp=true
