[Unit]
Description=Trader motor acilis-kapisi yeniden deneme (%i)
Documentation=file:///opt/trader/docs/hazirlik-denetimi.md

[Service]
Slice=trader.slice
Type=oneshot
User=root
# DD-9 §4.1: root birimi kodu YALNIZ root sahipli kopyadan calistirir; veri /opt/trader altindadir
ExecStart=/usr/local/lib/trader-root/venv/bin/python -I /usr/local/lib/trader-root/current/scripts/engine_retry.py --bot %i
Environment=TRADER_DATA_ROOT=/opt/trader
EnvironmentFile=/etc/trader-health.env
# NOTIFIER=auto: Telegram anahtarlari varsa outbox'a yazar (yoksa gunluge)
EnvironmentFile=-/etc/trader-telegram.env
SupplementaryGroups=trader-tg
UMask=0007
StateDirectory=trader-health
Environment=STATE_DIR=/var/lib/trader-health
TimeoutStartSec=60
MemoryMax=64M
CPUQuota=20%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/trader/trader/var
ReadWritePaths=/var/lib/trader-health /opt/trader/var/telegram
NoNewPrivileges=true
PrivateTmp=true
