[Unit]
Description=Trader aylik kagit evreni guncellemesi (DD-12 WP-16; D-T28; ag yok)
Documentation=file:///opt/trader/docs/motor/dd12-capraz-varlik-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/universe_run.py --apply
TimeoutStartSec=300
MemoryHigh=120M
MemoryMax=150M
CPUQuota=30%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var/universe -/opt/trader/var/learner -/opt/trader/var/market.sqlite-wal -/opt/trader/var/market.sqlite-shm
NoNewPrivileges=true
PrivateTmp=true
