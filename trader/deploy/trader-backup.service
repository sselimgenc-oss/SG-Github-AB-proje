[Unit]
Description=Trader gunluk yedek (defterler ve motor state veritabanlari)
Documentation=file:///opt/trader/docs/saglik-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/health_backup.py
EnvironmentFile=/etc/trader-health.env
Nice=19
IOSchedulingClass=idle
MemoryMax=96M
# 20: en az bir dosya basarisiz (uyari uretildi); beklenen cikis
SuccessExitStatus=20
ProtectSystem=strict
ProtectHome=read-only
# var YAZILABILIR: motor durmusken WAL defteri -shm dosyasi olmadan okunamaz (yedek yine mode=ro URI kullanir; OPEN-10)
ReadWritePaths=/var/backups/trader /opt/trader/var
NoNewPrivileges=true
PrivateTmp=true
