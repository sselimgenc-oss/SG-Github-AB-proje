[Unit]
Description=Trader gunluk yedek (defterler ve motor state veritabanlari)
Documentation=file:///opt/trader/docs/saglik-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=root
# DD-9 §4.1: root birimi kodu YALNIZ root sahipli kopyadan calistirir; veri /opt/trader altindadir
ExecStart=/usr/local/lib/trader-root/venv/bin/python -I /usr/local/lib/trader-root/current/scripts/health_backup.py
Environment=TRADER_DATA_ROOT=/opt/trader
EnvironmentFile=/etc/trader-health.env
Nice=19
IOSchedulingClass=idle
MemoryMax=96M
# 20: en az bir dosya basarisiz (uyari uretildi); beklenen cikis
SuccessExitStatus=20
ProtectSystem=strict
ProtectHome=read-only
# var YAZILABILIR: motor durmusken WAL defteri -shm dosyasi olmadan okunamaz (yedek yine mode=ro URI kullanir; OPEN-10)
ReadWritePaths=/var/backups/trader /opt/trader/var -/opt/trader/var-live
NoNewPrivileges=true
PrivateTmp=true
