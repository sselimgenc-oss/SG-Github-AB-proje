[Unit]
Description=Trader C1 kaldirma gocu (tek seferlik: defter + state + kasa; yedekli, dogrulamali, hata halinde geri yukler)
Documentation=file:///opt/trader/docs/motor/ct-ayrilik-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/trader
# Yalniz install.sh baslatir (zamanlayici yok), motor DURDURULMUSKEN. Telegram anahtari servislerle ayni dosyadan (systemd root olarak okur;
# dosya yoksa mesaj atlanir). Cikis 3 = onkosul yok (motor calisiyor / acik C1 pozisyonu): basarisiz sayilmaz, install sonra yeniden dener.
EnvironmentFile=-/etc/trader-telegram.env
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/c1_goc.py --var-dir /opt/trader/var --config-dir /opt/trader/config --motor-birimi trader-engine@learner.service
SuccessExitStatus=3
TimeoutStartSec=900
MemoryMax=256M
CPUQuota=50%
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
