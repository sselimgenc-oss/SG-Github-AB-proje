# /etc/trader-live.env  (izin 0600, sahibi root:root). SADECE CANLI (gercek para) Binance Futures anahtari.
# Gercek ALT HESAP anahtari: cekim/transfer yetkisi KAPALI, yalniz bu sunucunun IP'sine kisitli (motor acilista izinleri dogrular; cekim acik anahtar calistirilmaz).
# TESTNET anahtari buraya yazilmaz (o /etc/trader-testnet.env dosyasindadir). Sir degerleri depoya girmez; dosyayi nano ile siz doldurun, sohbete yazmayin.
# Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger. Esittir cevresinde bosluk yok; tirnak yok.
# LIVE_CONFIRM degeri config/engine.live.json `live.account_tag` ile AYNI olmali (su an: canli-alt1).
# Uc alan da dolana kadar `install.sh --live` canli birimi kurmaz; birim hicbir zaman kendiliginden baslamaz.
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_CONFIRM=
# Opsiyonel carpisma korumasi: baska hesap/bot anahtarlarinin SHA256 ozetleri (deger degil): TRADER_DIGER_ANAHTAR_SHA256=etiket:hex64,etiket2:hex64
# Ozet: printf %s "$ANAHTAR" | sha256sum   (ayni anahtar testnet/canli/baska botta kullanilirsa motor acilmaz: key_collision)
