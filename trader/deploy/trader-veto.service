[Unit]
Description=Trader Claude veto uretici (tek seferlik)
Documentation=file:///opt/trader/docs/veto-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/veto_run.py
EnvironmentFile=/etc/trader-veto.env
EnvironmentFile=/etc/trader-veto-hmac.env
TimeoutStartSec=120
# 10 bu tur karar yok, 11 butce/saglayici kaynakli unavailable belgesi: beklenen; 12 ve cokus OnFailure tetikler
SuccessExitStatus=10 11
MemoryMax=256M
CPUQuota=30%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/shared/veto /opt/trader/user_data
# market.sqlite (WAL) salt okunur acilir ama -shm dosyasi icin dizin yazilabilir olmali; uygulama yazmaz
ReadWritePaths=/opt/trader/var
NoNewPrivileges=true
PrivateTmp=true
