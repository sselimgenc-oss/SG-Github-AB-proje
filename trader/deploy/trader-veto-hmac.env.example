# /etc/trader-veto-hmac.env  (izin 0600, sahibi root:root). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# install.sh bos ise anahtari KENDISI uretir (openssl rand -hex 32; ekrana yazilmaz). Elle yazmaniz gerekmez.
# trader-veto.service (imzalar) ve trader-engine@.service (dogrular) ayni dosyayi okur; Anthropic API anahtari BURADA DEGIL (motora sizmaz).
TRADER_VETO_HMAC_KEY=
