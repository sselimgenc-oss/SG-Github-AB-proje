[Unit]
Description=Trader strateji verisi (beyin firtinasi icin): kurulumdan sonra BIR KEZ sessiz Telegram belgesi; salt okunur, yalniz bilgi
Documentation=file:///opt/trader/docs/panel-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/trader
# Telegram anahtari telegram servisiyle AYNI dosyadan (systemd root olarak okur); defter SALT OKUNUR acilir (migrate yok).
# Cikti: var/durum/strateji-veri-ml.md ve gonderim isareti var/durum/strateji_veri_gonderildi.json (surum 1; ikinci kez gonderilmez).
EnvironmentFile=/etc/trader-telegram.env
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/strateji_veri_run.py --once
TimeoutStartSec=180
MemoryMax=128M
CPUQuota=20%
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var/durum
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
