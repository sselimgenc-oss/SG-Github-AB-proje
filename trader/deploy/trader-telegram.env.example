# /etc/trader-telegram.env  (izin 0640, sahibi root:trader-tg; daemon, ders, health ayni dosyayi okur). Satir: bos, '#' ile
# baslayan tam satir yorum ya da AD=deger. Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir depoya girmez.
# Yeni bot, yeni token (CT'nin token'i paylasilmaz). Tek chat kimligi, yalniz ozel sohbet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VAR_DIR=/opt/trader/var/telegram
KILL_FILE=/opt/trader/shared/KILL
ENGINE_STATUS_PATH=/opt/trader/var/learner/status.json
LESSON_RUN_PATH=/opt/trader/scripts/lesson_run.py
HEALTH_STATE_PATH=/var/lib/trader-health/state.json
# Alt surec (lesson_run --resolve) icin ders yollari:
LEDGER_PATH=/opt/trader/var/learner/ledger.sqlite
LESSON_STORE_PATH=/opt/trader/user_data/lesson.sqlite
TWIN_LEDGER_PATH=/opt/trader/var/twin/ledger.sqlite
# /durdur (giris duraklatma, 11 §9): motorun cfg.pause_file + ".<bot>" yoluyla AYNI dosya; denetim: ENGINE_VAR_DIR/<bot>/pause_audit.jsonl
PAUSE_FILE=/opt/trader/shared/PAUSE
ENGINE_VAR_DIR=/opt/trader/var
PAUSE_BOTS=learner,twin
