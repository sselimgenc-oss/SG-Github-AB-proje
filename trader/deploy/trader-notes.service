[Unit]
Description=Trader gece islem notu ve aday ders yasam dongusu (kodla; LLM yok; DD-12 WP-09)
Documentation=file:///opt/trader/docs/motor/dd12-capraz-varlik-spec.md
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
EnvironmentFile=/etc/trader-lesson.env
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/notes_run.py --once
TimeoutStartSec=300
MemoryMax=256M
CPUQuota=30%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/user_data -/opt/trader/var/learner -/opt/trader/var-live/learner
NoNewPrivileges=true
PrivateTmp=true
