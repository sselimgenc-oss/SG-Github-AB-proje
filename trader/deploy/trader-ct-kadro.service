[Unit]
Description=Trader CT kadro uzlasisi okuyucu (C1; ct.kadro_yon.v1 -> var/ct/kadro_yon.json; herkese acik adres, anahtar yok)
Documentation=file:///opt/trader/docs/motor/c1-ct-kadro-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/trader
Environment=PYTHONUNBUFFERED=1
# Yanit/zaman asimi/HTTP hatasi durum.json'a yazilir (saglik WARN ct_kadro_bayat); birim basarisiz sayilmaz
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/ct_kadro_cek.py --var-dir /opt/trader/var
TimeoutStartSec=90
MemoryHigh=80M
MemoryMax=100M
CPUQuota=10%
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var/ct
