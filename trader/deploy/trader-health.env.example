# /etc/trader-health.env  (izin 0600, sahibi root). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir degerleri depoya girmez.
HEARTBEAT_URL=
HEARTBEAT_FAIL_URL=
# Motor var_dir (config/engine.base.json var_dir; icinde <bot>/status.json, ledger.sqlite, state.sqlite)
ENGINE_VAR_DIR=
BACKUP_DIR=/var/backups/trader
BACKUP_KEEP_DAYS=14
# auto: Telegram anahtarlari (/etc/trader-telegram.env) doluysa telegram, degilse log (anahtarsiz CRIT yalniz journal'a duser)
NOTIFIER=auto
# Beklenen motorlar (virgullu). install.sh ikiz acikken learner,twin; --no-twin ile learner yazar.
HEALTH_BOTS=learner,twin
# Veto belgesi tazelik alarmi (veto_file_age): belge mtime'i VETO_MAX_AGE_S saniyeden eskiyse uyari. Veto 30 dk'da bir calisir.
VETO_FILE=/opt/trader/shared/veto/veto.json
VETO_MAX_AGE_S=5400
HEALTH_MAINTENANCE_FILE=
# Piyasa verisi alarmlari (docs/saglik-spec.md Bolum 15). MARKET_DB bos ise kapali.
MARKET_DB=
# Cift listesi: ENGINE_CONFIG_DIR/engine.base.json `pairs` ya da virgullu MARKET_PAIRS (yoksa feed-status.json listesi).
ENGINE_CONFIG_DIR=
MARKET_PAIRS=
# Varsayilan: $ENGINE_VAR_DIR/feed-status.json
MARKET_FEED_STATUS=
# Testnet golge motoru var dizini (install.sh testnet anahtarlari doluysa var-testnet'e doldurur). Bos = golge motoru izlenmez.
HEALTH_SHADOW_VAR_DIR=
# PAUSE dosyasi tabani (motorun pause_file'i; `.<bot>` eklenir). Bos = <repo>/shared/PAUSE. Denetim gunlugu: ENGINE_VAR_DIR/<bot>/pause_audit.jsonl
PAUSE_FILE=
# Alarm esikleri (bos = varsayilan): stopsuz pozisyon (sn, 0 = hemen), borsaya ulasilamama CRIT suresi (sn)
NAKED_ALARM_S=
EXCHANGE_UNREACH_S=
# CANLIYA CIKISTA: motor var_dir'i canli dizine (or. var-live) cevrildiginde ENGINE_VAR_DIR'i (+ /etc/trader-telegram.env ENGINE_VAR_DIR'i)
# AYNI dizine cevirin ve PAUSE_FILE'i canli motorun pause_file'ina esitleyin; aksi halde saglik/telegram yanlis (kagit) dizini izler.
# Sapma izleyicisi kancasi (docs/saglik-spec.md 16.6): 1 = drift_monitor:<bot> kontrolu acik (<var>/<bot>/drift.json okunur), 0/bos = kapali (SKIPPED).
# install.sh izleyici zamanlayicilarini kurarken bos ise 1 yapar.
DRIFT_CHECK_ENABLED=
