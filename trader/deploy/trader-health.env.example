# /etc/trader-health.env  (izin 0600, sahibi root). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir degerleri depoya girmez.
HEARTBEAT_URL=
HEARTBEAT_FAIL_URL=
FREQTRADE_API_USER=
FREQTRADE_API_PASS=
LEARNER_API=http://127.0.0.1:8080
TWIN_API=http://127.0.0.1:8081
LEDGER_DIR=
FREQTRADE_USER_DATA_DIR=
BACKUP_DIR=/var/backups/trader
BACKUP_KEEP_DAYS=14
NOTIFIER=log
HEALTH_MAINTENANCE_FILE=
