[Unit]
Description=Trader haber/duygu toplayici (yalniz kayit; Fear & Greed + CoinDesk/Cointelegraph RSS -> var/durum/haber_v1.json; tek seferlik)
Documentation=file:///opt/trader/docs/haber-etiketi-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/trader
Environment=PYTHONUNBUFFERED=1
# Kaynak hatasi/zaman asimi yutulur (son onbellek korunur; birim basarisiz sayilmaz). Cikis 2 yalniz yerel yazma hatasi.
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/haber_run.py --var-dir /opt/trader/var
TimeoutStartSec=90
# Saf stdlib (pandas/numpy yok); olculen tepe RSS ~16 MB (sentetik getirici, 150 baslik) -> 100M tavan ~6 kat pay
MemoryHigh=80M
MemoryMax=100M
CPUQuota=10%
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# YAZILABILIR yalniz var/durum (haber_v1.json); yalniz https okuma icin IPv4/IPv6 + yerel soket
ReadWritePaths=/opt/trader/var/durum
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
