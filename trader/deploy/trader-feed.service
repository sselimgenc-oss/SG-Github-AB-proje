[Unit]
Description=Trader veri akisi (feed): Binance herkese acik REST -> var/market.sqlite (tek yazar)
Documentation=file:///opt/trader/docs/motor/01-feed.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service
# Hizli tekrar basarisizlikta (kural alinamiyor, bozuk ayar) sonsuz dongu olmasin; limite varinca OnFailure alarmi calisir
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Slice=trader.slice
# Son oldurulecekler (negatif deger yalniz root yonetici tarafindan, User= oncesi uygulanir; NoNewPrivileges/ProtectSystem engellemez) (WP-D)
OOMScoreAdjust=-200
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trader
Environment=PYTHONPATH=/opt/trader/src
Environment=PYTHONUNBUFFERED=1
# Acilista ag/5xx/bozuk JSON hatasi suresiz ustel geri cekilme (+jitter) ile beklenir; 418/451 ve eksik kural (yapilandirma) sifirdan farkli kodla cikar.
ExecStart=/usr/bin/python3 -m trader_engine feed --config-dir config --env paper --startup-retry forever
Restart=always
RestartSec=20
# 6 = HTTP 451 (konum kisiti), 3 = ban (418 / ust siniri asan Retry-After / 6 ardisik ban): tekrar denemek yasagi uzatir; dogrudan 'failed' olup OnFailure alarmini tetikler
RestartPreventExitStatus=3 6
MemoryHigh=200M
MemoryMax=260M
CPUQuota=60%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/var /opt/trader/shared /opt/trader/user_data

[Install]
WantedBy=multi-user.target
