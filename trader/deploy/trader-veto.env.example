# /etc/trader-veto.env  (izin 0600, sahibi root). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir degerleri depoya girmez.
ANTHROPIC_API_KEY_VETO=
# En az 32 karakter, rastgele; iki botun ortamindaki TRADER_VETO_HMAC_KEY ile AYNI deger. API anahtarindan farkli.
TRADER_VETO_HMAC_KEY=
