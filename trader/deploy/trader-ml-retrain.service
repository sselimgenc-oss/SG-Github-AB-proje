[Unit]
Description=Trader gece kurulum suzgeci egitimi (numpy; DD-12 WP-10)
Documentation=file:///opt/trader/docs/motor/dd12-capraz-varlik-spec.md
After=trader-lesson.service trader-notes.service
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/ml_retrain_run.py --once
TimeoutStartSec=300
MemoryHigh=250M
MemoryMax=300M
CPUQuota=50%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/trader/models /opt/trader/research -/opt/trader/var/learner
NoNewPrivileges=true
PrivateTmp=true
