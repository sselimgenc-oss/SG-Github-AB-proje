# Kopyala: cp .env.example .env  ve gercek degerleri SUNUCUDA doldur. .env git'e girmez.
# Not: iki bot da ayni .env'i okur; farkli kimlik bilgisi gerekirse compose'ta env_file'i ayirin.
FREQTRADE__API_SERVER__USERNAME=degistir
FREQTRADE__API_SERVER__PASSWORD=degistir
FREQTRADE__API_SERVER__JWT_SECRET_KEY=degistir
